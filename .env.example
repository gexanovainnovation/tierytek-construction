# ==============================================================================
# TIERYTEK CONSTRUCTION - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL or Local)
# ------------------------------------------------------------------------------
# For Neon: Copy the pooled connection string from your Neon Console.
# Make sure "?sslmode=require" is included at the end!
# Example: postgresql://neondb_owner:npg_xxxxxxxx@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE (Cloudflare R2)
# ------------------------------------------------------------------------------
# Optional for local offline development (falls back to public/uploads automatically).
# Required for Vercel/Production deployment.
# R2 Account ID: Found on the Cloudflare Dashboard right side under "Account ID"
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 Access Key & Secret: Generated in Cloudflare R2 > "Manage R2 API Tokens"
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Name: The exact bucket name you created in R2
R2_BUCKET_NAME=tierytek-media

# R2 Public URL: Either the R2.dev public URL (e.g. https://pub-xxxxxx.r2.dev)
# OR your custom domain mapped to the R2 bucket (e.g. https://media.tierytek.com)
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# ------------------------------------------------------------------------------
# 3. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
